// Keyboard identity tables: SDL scancodes (USB HID usage IDs) to Win32
// virtual-key codes and DirectInput DIK codes (PC set-1 scancodes, E0-prefixed
// keys with bit 7 set).
package win32

import sdl "vendor:sdl3"

// KEYMAP[scancode] = {VK, DIK}; zero for keys the game cannot see.
KEYMAP := [232][2]u8 {
	4 = {0x41, 0x1e}, 5 = {0x42, 0x30}, 6 = {0x43, 0x2e}, 7 = {0x44, 0x20},
	8 = {0x45, 0x12}, 9 = {0x46, 0x21}, 10 = {0x47, 0x22}, 11 = {0x48, 0x23},
	12 = {0x49, 0x17}, 13 = {0x4a, 0x24}, 14 = {0x4b, 0x25}, 15 = {0x4c, 0x26},
	16 = {0x4d, 0x32}, 17 = {0x4e, 0x31}, 18 = {0x4f, 0x18}, 19 = {0x50, 0x19},
	20 = {0x51, 0x10}, 21 = {0x52, 0x13}, 22 = {0x53, 0x1f}, 23 = {0x54, 0x14},
	24 = {0x55, 0x16}, 25 = {0x56, 0x2f}, 26 = {0x57, 0x11}, 27 = {0x58, 0x2d},
	28 = {0x59, 0x15}, 29 = {0x5a, 0x2c},
	30 = {0x31, 0x02}, 31 = {0x32, 0x03}, 32 = {0x33, 0x04}, 33 = {0x34, 0x05},
	34 = {0x35, 0x06}, 35 = {0x36, 0x07}, 36 = {0x37, 0x08}, 37 = {0x38, 0x09},
	38 = {0x39, 0x0a}, 39 = {0x30, 0x0b},
	40 = {0x0d, 0x1c}, 41 = {0x1b, 0x01}, 42 = {0x08, 0x0e}, 43 = {0x09, 0x0f},
	44 = {0x20, 0x39}, 45 = {0xbd, 0x0c}, 46 = {0xbb, 0x0d}, 47 = {0xdb, 0x1a},
	48 = {0xdd, 0x1b}, 49 = {0xdc, 0x2b}, 51 = {0xba, 0x27}, 52 = {0xde, 0x28},
	53 = {0xc0, 0x29}, 54 = {0xbc, 0x33}, 55 = {0xbe, 0x34}, 56 = {0xbf, 0x35},
	57 = {0x14, 0x3a},
	58 = {0x70, 0x3b}, 59 = {0x71, 0x3c}, 60 = {0x72, 0x3d}, 61 = {0x73, 0x3e},
	62 = {0x74, 0x3f}, 63 = {0x75, 0x40}, 64 = {0x76, 0x41}, 65 = {0x77, 0x42},
	66 = {0x78, 0x43}, 67 = {0x79, 0x44}, 68 = {0x7a, 0x57}, 69 = {0x7b, 0x58},
	70 = {0x2c, 0xb7}, 71 = {0x91, 0x46}, 72 = {0x13, 0xc5}, 73 = {0x2d, 0xd2},
	74 = {0x24, 0xc7}, 75 = {0x21, 0xc9}, 76 = {0x2e, 0xd3}, 77 = {0x23, 0xcf},
	78 = {0x22, 0xd1}, 79 = {0x27, 0xcd}, 80 = {0x25, 0xcb}, 81 = {0x28, 0xd0},
	82 = {0x26, 0xc8},
	83 = {0x90, 0x45}, 84 = {0x6f, 0xb5}, 85 = {0x6a, 0x37}, 86 = {0x6d, 0x4a},
	87 = {0x6b, 0x4e}, 88 = {0x0d, 0x9c}, 89 = {0x61, 0x4f}, 90 = {0x62, 0x50},
	91 = {0x63, 0x51}, 92 = {0x64, 0x4b}, 93 = {0x65, 0x4c}, 94 = {0x66, 0x4d},
	95 = {0x67, 0x47}, 96 = {0x68, 0x48}, 97 = {0x69, 0x49}, 98 = {0x60, 0x52},
	99 = {0x6e, 0x53},
	224 = {0x11, 0x1d}, 225 = {0x10, 0x2a}, 226 = {0x12, 0x38}, 227 = {0x5b, 0xdb},
	228 = {0x11, 0x9d}, 229 = {0x10, 0x36}, 230 = {0x12, 0xb8}, 231 = {0x5c, 0xdc},
}

scancode_vk :: proc(s: sdl.Scancode) -> u32 {
	return int(s) < len(KEYMAP) ? u32(KEYMAP[s][0]) : 0
}

scancode_dik :: proc(s: sdl.Scancode) -> u8 {
	return int(s) < len(KEYMAP) ? KEYMAP[s][1] : 0
}

// Left/right-specific VK_LSHIFT..VK_RMENU (0xa0..0xa5) to their scancodes.
SIDED_VK := [6]u8{225, 229, 224, 228, 226, 230}

// GetAsyncKeyState semantics: mouse buttons VK 1/2/4, sided modifiers, and
// otherwise any scancode that maps to the VK. Under lockstep nothing is
// down: only the pads, as all peers share them, drive the game.
vk_down :: proc(vk: u32) -> bool {
	if lockstep {return false}
	switch vk {
	case 1, 2, 4:
		b := sdl.GetMouseState(nil, nil)
		bit: sdl.MouseButtonFlags = vk == 1 ? {.LEFT} : (vk == 2 ? {.RIGHT} : {.MIDDLE})
		return b & bit != {}
	}
	n: i32
	keys := sdl.GetKeyboardState(&n)
	if vk >= 0xa0 && vk <= 0xa5 {
		return keys[SIDED_VK[vk - 0xa0]]
	}
	for s in 0 ..< min(int(n), len(KEYMAP)) {
		if KEYMAP[s][0] != 0 && u32(KEYMAP[s][0]) == vk && keys[s] {
			return true
		}
	}
	return false
}
