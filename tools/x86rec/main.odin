// Static recompiler: JadeEmpire.exe x86 to Odin (docs/recompiler.md).
// Usage: x86rec <exe> <ghidra_funcs.txt> <out dir>
package x86rec

import "base:runtime"
import "core:fmt"
import vmem "core:mem/virtual"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strconv"
import "core:strings"

read_ghidra :: proc(path: string) -> []u32 {
	data, err := os.read_entire_file(path, context.allocator)
	fmt.assertf(err == nil, "read %s: %v", path, err)
	out: [dynamic]u32
	text_s := string(data)
	for line in strings.split_lines_iterator(&text_s) {
		t := strings.trim_space(line)
		if t == "" do continue
		end := strings.index_any(t, " \t")
		if end < 0 do end = len(t)
		h := t[:end]
		if strings.has_prefix(h, "0x") || strings.has_prefix(h, "0X") do h = h[2:]
		v, ok := strconv.parse_uint(h, 16)
		fmt.assertf(ok, "bad ghidra line %q", line)
		append(&out, u32(v))
	}
	return out[:]
}

main :: proc() {
	args := os.args
	if len(args) != 4 {
		fmt.eprintln("usage: x86rec <exe> <ghidra_funcs.txt> <out dir>")
		os.exit(2)
	}
	image_load(args[1])
	ghidra := read_ghidra(args[2])
	kept, rejected := build_funcs(ghidra)
	slice.sort_by(kept, proc(a, b: ^Func) -> bool {return a.start < b.start})
	finish_funcs(kept)
	funcs = kept
	finish_flow()

	flag := flag_liveness()
	mod := gpr_mod()
	live0, _ := gpr_liveness(mod, {})
	fnames := load_names(strings.concatenate({filepath.dir(args[2]), "/funcnames.txt"}))
	host := host_pops(strings.concatenate({filepath.dir(args[3]), "/win32"}))
	fmt.printf("%d of %d imports with known argument pops\n", len(host), len(img.iat))
	taken := taken_entries()
	transp := transparency(live0.entry_live, mod, taken, host)
	gpr, ntaken := gpr_liveness(mod, transp)
	check_indirect_calls()
	nret, nentry := 0, 0
	for v in flag.ret_live do if v != 0 do nret += 1
	for v in flag.entry_live do if v != 0 do nentry += 1
	fmt.printf("flags live at ret in %d functions, at %d entries\n", nret, nentry)
	sync := sync_new(&flag, &gpr, mod, transp)
	fmt.printf("%d functions reachable through pointers\n", ntaken)
	fmt.print("transparent registers:")
	sep := " "
	for r, k in R32 {
		if SAVED >> uint(k) & 1 == 0 do continue
		c := 0
		for _, v in transp do if v >> uint(k) & 1 != 0 do c += 1
		fmt.printf("%s%s %d", sep, r, c)
		sep = ", "
	}
	fmt.println()
	// Packages of about PACKAGE_INSNS instructions, in address order.
	pkgs: [dynamic][2]int // [first, end) funcs index
	first, ncur := 0, 0
	for f, n in funcs {
		ncur += len(f.insns)
		if ncur >= PACKAGE_INSNS {
			append(&pkgs, [2]int{first, n + 1})
			first, ncur = n + 1, 0
		}
	}
	if first < len(funcs) do append(&pkgs, [2]int{first, len(funcs)})
	out_dir := args[3]
	src_dir := filepath.dir(out_dir)
	inl_names, inl_body := inline_helpers(strings.concatenate({src_dir, "/x86"}))
	native, spans := native_scan(strings.concatenate({src_dir, "/native"}))
	for s in spans {
		found := false
		for f in funcs do if inside(f, s) && set_has(f.labels, s) do found = true
		fmt.assertf(found, "span start is not a block")
	}
	for a in native {
		found := false
		for f in funcs do if set_has(f.entries, a) do found = true
		fmt.assertf(found, "native procs without a guest function: 0x%x", a)
	}
	fmt.printf("%d native replacements, %d spans\n", len(native), len(spans))
	// Made before the per-package arenas so they keep the default allocator.
	unsupported := make(map[string]int)
	unsup_order := make([dynamic]string)
	nstruct, ndisp, total := 0, 0, 0
	pnames := make([dynamic]string)
	for pk, k in pkgs {
		arena: vmem.Arena
		aerr := vmem.arena_init_growing(&arena)
		assert(aerr == nil)
		context.allocator = vmem.arena_allocator(&arena)
		pname := fmt.aprintf("m%02d", k)
		append(&pnames, strings.clone(pname, context.temp_allocator))
		em := Emitter{native = native, spans = spans, names = fnames, sync = &sync}
		for _, sp in spans do set_add(&em.span_exits, sp.exit)
		for n in pk[0] ..< pk[1] {
			f := funcs[n]
			for e in f.entries do em.local[e] = proc_name(f, e, fnames)
		}
		out: [dynamic]string
		append(&out, "// Generated by tools/x86rec. Do not edit.", fmt.aprintf("package %s", pname), "", `import "base:intrinsics"`, `import "core:math"`, `import "../../x86"`)
		head := len(out)
		for n in pk[0] ..< pk[1] {
			emit_func(&em, n, &out)
			total += len(funcs[n].insns)
		}
		if em.uses_native do inject_at(&out, head, `import "../../native"`)
		inject_at(&out, head + (em.uses_native ? 1 : 0), "", "_ :: intrinsics", "_ :: math", "")
		append(&out, "FUNCS := [?]x86.Func_Entry{")
		for n in pk[0] ..< pk[1] {
			for e in set_sorted(funcs[n].entries) do append(&out, fmt.aprintf("\t{{%s, %s}},", hexu(e), em.local[e]))
		}
		append(&out, "}", "", "// Copies of the x86 package's contextless #force_inline helpers.")
		append(&out, ..inl_body)
		text := strings.join(out[:], "\n")
		b := strings.builder_make()
		localize_calls(&b, text, inl_names)
		d := strings.concatenate({out_dir, "/", pname})
		os.make_directory_all(d)
		werr := os.write_entire_file(strings.concatenate({d, "/code.odin"}), b.buf[:])
		fmt.assertf(werr == nil, "write %s: %v", d, werr)
		nstruct += em.structured
		ndisp += em.dispatched
		for key in em.unsup_order {
			if !(key in unsupported) {
				kc := strings.clone(key, context.temp_allocator)
				append(&unsup_order, kc)
				unsupported[kc] = 0
			}
			unsupported[key] += em.unsupported[key]
		}
		context.allocator = runtime.default_allocator()
		vmem.arena_destroy(&arena)
	}
	reg: [dynamic]string
	append(&reg, "// Generated by tools/x86rec. Do not edit.", "package rec", "", `import "../x86"`, `import "../native"`)
	for n in pnames do append(&reg, fmt.aprintf(`import "%s"`, n))
	append(&reg, "", "register :: proc() {")
	for n in pnames do append(&reg, fmt.aprintf("\tx86.register_funcs(%s.FUNCS[:])", n))
	append(&reg, "\tnative.register()", "}")
	werr := os.write_entire_file(strings.concatenate({out_dir, "/rec.odin"}), transmute([]u8)strings.concatenate({strings.join(reg[:], "\n"), "\n"}))
	fmt.assertf(werr == nil, "write rec.odin: %v", werr)
	nentries := 0
	for f in funcs do nentries += len(f.entries)
	fmt.printf("functions %d, entries %d, instructions %d, packages %d, data pointers rejected %d\n", len(funcs), nentries, total, len(pkgs), rejected)
	fmt.printf("%d functions structured, %d dispatched\n", nstruct, ndisp)
	order := unsup_order[:]
	// Most frequent first; ties keep first-seen order.
	for i in 1 ..< len(order) {
		for j := i; j > 0 && unsupported[order[j]] > unsupported[order[j - 1]]; j -= 1 do order[j], order[j - 1] = order[j - 1], order[j]
	}
	// Odin pads %6d with zeros; the space flag pads with spaces.
	for key in order do fmt.printf("unsupported % 6d %s\n", unsupported[key], key)
}
